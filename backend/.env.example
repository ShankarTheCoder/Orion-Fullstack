PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/farm_picked
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Email OTP delivery (Choose Option A: Gmail SMTP OR Option B: Resend) ---
# Option A: Gmail / Nodemailer SMTP (Easiest & Free)
# 1. Enable 2-Factor Authentication on your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App password (named e.g. "Orion Store") and paste the 16-character code below:
SMTP_USER=
SMTP_PASS=
# Optional SMTP host/port (defaults to Gmail service if using @gmail.com):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Option B: Resend (https://resend.com)
# Create a free Resend account, get API key, and paste below:
RESEND_API_KEY=
EMAIL_FROM=Orion <onboarding@resend.dev>

# NOTE: If both SMTP and Resend are empty, Orion runs in DEV MODE:
# The 6-digit random OTP is logged to your terminal console and returned in the UI
# so you can sign up, verify email, and reset passwords locally without any credentials!

# --- Admin account (REQUIRED before seeding) ---
# `npm run seed` creates/updates ONLY this admin — nothing else. There are
# NO demo accounts and NO default admin password: if ADMIN_EMAIL or
# ADMIN_PASSWORD is missing, the seed prints an error and creates nothing.
# The store starts empty (no products/categories/customers/orders); the
# admin signs in on the normal /login page and adds real categories and
# products from the Admin panel. Re-running the seed after editing these
# values UPDATES the admin's name + password.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=set-your-own-password
