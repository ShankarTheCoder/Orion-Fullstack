PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/farm_picked
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Email OTP verification via Resend (https://resend.com) ---
# Create a free Resend account, go to API Keys -> Create API Key, and paste
# the key here in your real .env (never commit the real key).
# Leave EMPTY to run in DEV MODE: OTPs are printed to the server console
# instead of being emailed, so local development/testing still works.
RESEND_API_KEY=
# Sender shown on OTP emails. The default is Resend's shared test sender,
# which (in free/test mode) can only deliver to the email address that owns
# the Resend account - verify your own domain in Resend to email anyone.
EMAIL_FROM=Orion <onboarding@resend.dev>

# --- Admin account (REQUIRED before seeding) ---
# `npm run seed` creates/updates ONLY this admin — nothing else. There are
# NO demo accounts and NO default admin password: if ADMIN_EMAIL or
# ADMIN_PASSWORD is missing, the seed prints an error and creates nothing.
# The store starts empty (no products/categories/customers/orders); the
# admin signs in on the normal /login page and adds real categories and
# products from the Admin panel. Re-running the seed after editing these
# values UPDATES the admin's name + password.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=set-your-own-password
