# Base URL of the Orion Express API.
#
# LOCAL DEVELOPMENT (default):
#   The backend runs on port 5000 on your own computer.
#   VITE_API_URL=http://localhost:5000/api/v1
#
# PRODUCTION (Vercel):
#   Set this to the PUBLIC URL of your hosted backend, for example a Render
#   web service. Do NOT use localhost here — on Vercel, visitors' browsers
#   would call their own computer's localhost, which is empty, and every
#   request fails with "Failed to fetch" (no products, no categories).
#   Example:
#   VITE_API_URL=https://your-backend-service.onrender.com/api/v1
#
# IMPORTANT: VITE_API_URL is a BUILD-time variable. Changing it in the
# Vercel dashboard only takes effect after you redeploy the frontend.
VITE_API_URL=http://localhost:5000/api/v1
